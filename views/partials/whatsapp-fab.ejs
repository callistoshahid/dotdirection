<!-- Live Event Floating Button + Coming Soon Popup -->
<style>
    .live-event-fab {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        z-index: 90;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, #25D366, #16a34a);
        color: #ffffff;
        padding: 0.75rem 1.15rem;
        border-radius: 9999px;
        font-weight: 800;
        font-size: 0.9rem;
        line-height: 1;
        border: 0;
        cursor: pointer;
        box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.75), 0 12px 30px rgba(22, 163, 74, 0.35);
        animation: live-event-glow 1.8s ease-in-out infinite;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .live-event-fab:hover {
        transform: translateY(-3px) scale(1.04);
        box-shadow: 0 18px 40px rgba(22, 163, 74, 0.45);
    }

    @keyframes live-event-glow {
        0% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7), 0 12px 30px rgba(22, 163, 74, 0.35); }
        70% { box-shadow: 0 0 0 18px rgba(37, 211, 102, 0), 0 12px 30px rgba(22, 163, 74, 0.35); }
        100% { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0), 0 12px 30px rgba(22, 163, 74, 0.35); }
    }

    .live-event-fab .live-dot {
        width: 8px;
        height: 8px;
        border-radius: 9999px;
        background: #ffffff;
        animation: live-event-blink 1s step-end infinite;
    }

    @keyframes live-event-blink {
        50% { opacity: 0.15; }
    }

    .live-event-modal {
        position: fixed;
        inset: 0;
        z-index: 120;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(15, 23, 42, 0.72);
        backdrop-filter: blur(8px);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.28s ease;
    }

    .live-event-modal.is-open {
        opacity: 1;
        pointer-events: auto;
    }

    .live-event-panel {
        width: 100%;
        max-width: 620px;
        background: #ffffff;
        border-radius: 1.5rem;
        box-shadow: 0 30px 80px rgba(15, 23, 42, 0.35);
        transform: translateY(14px) scale(0.96);
        transition: transform 0.28s ease;
        overflow: hidden;
    }

    .live-event-modal.is-open .live-event-panel {
        transform: translateY(0) scale(1);
    }

    .live-event-card {
        position: relative;
        border: 1px solid #e5e7eb;
        border-radius: 1rem;
        padding: 1rem;
        background: linear-gradient(180deg, #ffffff, #f9fafb);
        opacity: 0.72;
        cursor: not-allowed;
    }

    .live-event-card::after {
        content: "Coming Soon";
        position: absolute;
        top: 0.8rem;
        right: 0.8rem;
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #92400e;
        background: #fef3c7;
        border: 1px solid #fde68a;
        border-radius: 9999px;
        padding: 0.25rem 0.55rem;
    }
</style>

<button type="button" id="live-event-open" class="live-event-fab" aria-label="Open live events popup">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
        <path d="M15 10l4.553-2.276A1 1 0 0 1 21 8.618v6.764a1 1 0 0 1-1.447.894L15 14" />
        <rect x="3" y="6" width="12" height="12" rx="2" />
    </svg>
    <span>Live Event</span>
    <span class="live-dot"></span>
</button>

<div id="live-event-modal" class="live-event-modal" aria-hidden="true">
    <div class="live-event-panel">
        <div class="flex items-start justify-between gap-4 p-6 border-b border-gray-100 bg-gradient-to-r from-green-50 to-emerald-50">
            <div>
                <span class="inline-flex items-center gap-2 bg-green-600 text-white text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-3">
                    <span class="w-2 h-2 bg-white rounded-full animate-pulse"></span>
                    Live Events
                </span>
                <h3 class="font-serif text-2xl font-bold text-gray-900">Choose a Live Event</h3>
                <p class="text-sm text-gray-600 mt-1">Event galleries are launching soon. These events are currently disabled.</p>
            </div>
            <button type="button" id="live-event-close" class="text-gray-500 hover:text-gray-900 p-1" aria-label="Close live events popup">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="live-event-card" aria-disabled="true">
                <h4 class="font-bold text-gray-900 pr-24">Wedding Live Gallery</h4>
                <p class="text-sm text-gray-500 mt-1">Real-time wedding photo updates for guests.</p>
            </div>
            <div class="live-event-card" aria-disabled="true">
                <h4 class="font-bold text-gray-900 pr-24">Corporate Event Album</h4>
                <p class="text-sm text-gray-500 mt-1">Conference and brand activation highlights.</p>
            </div>
            <div class="live-event-card" aria-disabled="true">
                <h4 class="font-bold text-gray-900 pr-24">Birthday / Party Moments</h4>
                <p class="text-sm text-gray-500 mt-1">Live memories from private celebrations.</p>
            </div>
            <div class="live-event-card" aria-disabled="true">
                <h4 class="font-bold text-gray-900 pr-24">Spiritual Event Photos</h4>
                <p class="text-sm text-gray-500 mt-1">Devotional event photo gallery access.</p>
            </div>
        </div>

        <div class="px-6 pb-6">
            <div class="rounded-xl bg-gray-50 border border-gray-100 p-4 text-sm text-gray-600">
                Need help finding your event? Contact us on WhatsApp: <a href="https://wa.me/916398962566" target="_blank" rel="noopener" class="font-bold text-green-600 hover:underline">+91 63989 62566</a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const openBtn = document.getElementById('live-event-open');
        const modal = document.getElementById('live-event-modal');
        const closeBtn = document.getElementById('live-event-close');

        if (!openBtn || !modal || !closeBtn) return;

        function openModal() {
            modal.classList.add('is-open');
            modal.setAttribute('aria-hidden', 'false');
        }

        function closeModal() {
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
        }

        openBtn.addEventListener('click', openModal);
        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', (event) => {
            if (event.target === modal) closeModal();
        });
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') closeModal();
        });
    });
</script>