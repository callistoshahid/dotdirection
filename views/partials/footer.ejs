<!-- Footer: Massive SEO Silo Directory -->
<footer class="bg-[#1b222a] pt-16 pb-10 border-t-4 border-metallic">
    <div class="container mx-auto px-6 md:px-8">

        <!-- Footer Middle: Standard Links & Socials -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-10 border-b border-gray-800">

            <!-- Logo & Socials -->
            <div class="col-span-2 md:col-span-1">
                <img src="<%= site.logoWhite %>" alt="Dot Direction"
                    class="h-10 object-contain mb-6 opacity-80"
                    onerror="this.onerror=null; this.src='<%= site.logoFallbackWhite %>';" />
                <p class="text-gray-500 font-light text-sm leading-relaxed max-w-xs mb-8">Connecting visionary clients
                    with extraordinary visual artists across India. Quality guaranteed.</p>

                <!-- Social Icons -->
                <div class="flex items-center gap-5">
                    <% socials.forEach(social => { %>
                    <a href="<%= social.href %>" target="_blank"
                        class="text-gray-400 <%= social.hoverClass %> transition-colors duration-300" title="<%= social.title %>">
                        <%- include('social-icons/' + social.icon + '.ejs') %>
                    </a>
                    <% }); %>
                </div>
            </div>

            <div>
                <h4 class="text-white font-semibold tracking-wide mb-6">Company</h4>
                <ul class="space-y-4 text-sm text-gray-400 font-light">
                    <% footerLinks.company.forEach(link => { %>
                        <li><a href="<%= link.href %>" class="hover:text-metallic transition-colors"><%= link.label %></a></li>
                    <% }); %>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-semibold tracking-wide mb-6">For Professionals</h4>
                <ul class="space-y-4 text-sm text-gray-400 font-light">
                    <% footerLinks.professionals.forEach(link => { %>
                        <li><a href="<%= link.href %>" class="hover:text-metallic transition-colors"><%= link.label %></a></li>
                    <% }); %>
                </ul>
            </div>
            <div>
                <h4 class="text-white font-semibold tracking-wide mb-6">Support & Legal</h4>
                <ul class="space-y-4 text-sm text-gray-400 font-light">
                    <% footerLinks.support.forEach(link => { %>
                        <li><a href="<%= link.href %>" class="hover:text-metallic transition-colors"><%= link.label %></a></li>
                    <% }); %>
                </ul>
            </div>
        </div>

        <!-- Footer Bottom: SEO Powerhouse Silo -->
        <div class="py-16 grid grid-cols-2 md:grid-cols-4 gap-8">
            <!-- Category 1: Locations -->
            <div>
                <h5 class="text-gray-300 font-semibold text-sm mb-4">Top Locations</h5>
                <ul class="space-y-2 text-xs text-gray-500">
                    <% footerLinks.locations.forEach(link => { %>
                        <li><a href="<%= link.href %>" class="hover:text-gray-300 transition-colors"><%= link.label %></a></li>
                    <% }); %>
                </ul>
            </div>
            <!-- Category 2: Occasions -->
            <div>
                <h5 class="text-gray-300 font-semibold text-sm mb-4">By Occasion</h5>
                <ul class="space-y-2 text-xs text-gray-500">
                    <% footerLinks.occasions.forEach(link => { %>
                        <li><a href="<%= link.href %>" class="hover:text-gray-300 transition-colors"><%= link.label %></a></li>
                    <% }); %>
                </ul>
            </div>
            <!-- Category 3: Pro Types -->
            <div>
                <h5 class="text-gray-300 font-semibold text-sm mb-4">Hire Professionals</h5>
                <ul class="space-y-2 text-xs text-gray-500">
                    <% footerLinks.hire.forEach(link => { %>
                        <li><a href="<%= link.href %>" class="hover:text-gray-300 transition-colors"><%= link.label %></a></li>
                    <% }); %>
                </ul>
            </div>
            <!-- Category 4: Guides -->
            <div>
                <h5 class="text-gray-300 font-semibold text-sm mb-4">Guides & Resources</h5>
                <ul class="space-y-2 text-xs text-gray-500">
                    <% footerLinks.guides.forEach(link => { %>
                        <li><a href="<%= link.href %>" class="hover:text-gray-300 transition-colors"><%= link.label %></a></li>
                    <% }); %>
                </ul>
            </div>
        </div>

        <!-- Copyright -->
        <div class="pt-8 border-t border-gray-800 text-center flex flex-col items-center">
            <p id="copyright-year" class="text-gray-600 text-xs"></p>
        </div>
    </div>
</footer>