<%- include('../partials/head.ejs') %>

<body class="font-sans text-[#333333] bg-white selection:bg-metallic-light selection:text-white overflow-x-hidden">
    <%- include('../partials/navbar.ejs') %>
    <main class="pt-32 md:pt-40 pb-24 bg-white min-h-screen">
        <article class="container mx-auto px-6 md:px-8 max-w-4xl">
            <a href="/blogs" class="text-metallic font-semibold text-sm hover:underline">← Back to Blogs</a>
            <header class="mt-6 mb-10">
                <p class="text-xs text-gray-400 uppercase tracking-widest font-bold mb-4"><%= new Date(blog.createdAt).toLocaleDateString() %></p>
                <h1 class="font-serif text-4xl md:text-6xl font-bold text-gray-900 leading-tight mb-6"><%= blog.title %></h1>
                <% if (blog.excerpt) { %><p class="text-xl text-gray-600 font-light leading-relaxed"><%= blog.excerpt %></p><% } %>
            </header>

            <% if (blog.coverImage) { %>
                <img src="<%= blog.coverImage %>" alt="<%= blog.title %>" class="w-full rounded-3xl shadow-xl mb-10 object-cover max-h-[520px]">
            <% } %>

            <style>
                .blog-content h2 { font-family: 'Playfair Display', serif; font-size: 2rem; line-height: 1.2; font-weight: 700; color: #111827; margin: 2rem 0 1rem; }
                .blog-content h3 { font-family: 'Playfair Display', serif; font-size: 1.5rem; line-height: 1.3; font-weight: 700; color: #111827; margin: 1.75rem 0 0.75rem; }
                .blog-content p { margin: 1rem 0; color: #4b5563; line-height: 1.85; }
                .blog-content ul, .blog-content ol { margin: 1rem 0 1rem 1.5rem; color: #4b5563; line-height: 1.85; }
                .blog-content ul { list-style: disc; }
                .blog-content ol { list-style: decimal; }
                .blog-content blockquote { border-left: 4px solid #788596; padding-left: 1rem; margin: 1.5rem 0; color: #374151; font-style: italic; background: #f8fafc; padding-top: 1rem; padding-bottom: 1rem; border-radius: 0 0.75rem 0.75rem 0; }
                .blog-content a { color: #788596; font-weight: 600; text-decoration: underline; }
                .blog-content figure.table { overflow-x: auto; }
                .blog-content table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
                .blog-content th, .blog-content td { border: 1px solid #e5e7eb; padding: 0.75rem; text-align: left; }
                .blog-content th { background: #f9fafb; color: #111827; }
            </style>
            <div class="blog-content max-w-none"><%- blog.content %></div>
        </article>
    </main>
    <%- include('../partials/footer.ejs') %>
    <%- include('../partials/scripts-common.ejs') %>
</body>
</html>