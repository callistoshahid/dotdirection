<%- include('../partials/head.ejs') %>

<body class="font-sans text-[#333333] bg-white selection:bg-metallic-light selection:text-white overflow-x-hidden">
    <%- include('../partials/navbar.ejs') %>
    <main class="pt-32 md:pt-40 pb-24 bg-[#F8F9FA] min-h-screen">
        <div class="container mx-auto px-6 md:px-8">
            <div class="text-center max-w-3xl mx-auto mb-14">
                <span class="inline-block bg-white text-metallic border border-gray-200 rounded-full px-4 py-1.5 text-xs font-bold tracking-widest uppercase mb-4 shadow-sm">Blogs</span>
                <h1 class="font-serif text-4xl md:text-6xl font-bold text-gray-900 mb-5">Stories, Tips & Guides</h1>
                <p class="text-lg text-gray-600 font-light">Photography insights, event planning ideas, and creative resources from Dot Direction.</p>
            </div>

            <% if (blogs.length === 0) { %>
                <div class="bg-white rounded-2xl border border-gray-100 p-12 text-center text-gray-400 max-w-2xl mx-auto">No blogs published yet.</div>
            <% } else { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% blogs.forEach(blog => { %>
                    <article class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden hover:shadow-xl transition-shadow">
                        <% if (blog.coverImage) { %><img src="<%= blog.coverImage %>" alt="<%= blog.title %>" class="w-full h-56 object-cover"><% } %>
                        <div class="p-6">
                            <p class="text-xs text-gray-400 uppercase tracking-widest font-bold mb-3"><%= new Date(blog.createdAt).toLocaleDateString() %></p>
                            <h2 class="font-serif text-2xl font-bold text-gray-900 mb-3"><a href="/blogs/<%= blog.slug %>" class="hover:text-metallic"><%= blog.title %></a></h2>
                            <p class="text-gray-600 text-sm leading-relaxed mb-5"><%= blog.excerpt || blog.content.slice(0, 140) + '...' %></p>
                            <a href="/blogs/<%= blog.slug %>" class="text-metallic font-bold hover:underline">Read More →</a>
                        </div>
                    </article>
                    <% }); %>
                </div>
            <% } %>
        </div>
    </main>
    <%- include('../partials/footer.ejs') %>
    <%- include('../partials/scripts-common.ejs') %>
</body>
</html>