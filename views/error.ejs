<%- include('partials/head.ejs') %>

<body class="font-sans text-[#333333] bg-[#F8F9FA] selection:bg-metallic-light selection:text-white">

    <%- include('partials/navbar.ejs') %>

    <main class="pt-32 md:pt-40 pb-24 flex items-center justify-center min-h-[80vh]">
        <div class="container mx-auto px-6 md:px-8 text-center">
            <h1 class="font-serif text-6xl md:text-7xl font-bold text-metallic mb-6">500</h1>
            <h2 class="font-serif text-2xl md:text-3xl font-semibold text-gray-900 mb-4">Something went wrong</h2>
            <p class="text-gray-600 font-light text-lg mb-10 max-w-md mx-auto">
                We encountered an unexpected error while processing your request.
                <% if (typeof message !== 'undefined' && message) { %>
                    <span class="block text-xs mt-2 text-gray-400">Error: <%= message %></span>
                <% } %>
            </p>
            <a href="/" class="inline-block bg-metallic hover:bg-metallic-hover text-white font-medium py-3 px-8 rounded-lg transition-all shadow-lg transform hover:-translate-y-0.5">
                Return to Homepage
            </a>
        </div>
    </main>

    <%- include('partials/footer.ejs') %>
    <%- include('partials/scripts-common.ejs') %>

</body>
</html>